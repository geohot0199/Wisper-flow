{
  "name": "@wisper-flow/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Wisper Flow mobile (React Native) — share the refinement engine with desktop",
  "scripts": {
    "ios": "react-native run-ios",
    "android": "react-native run-android",
    "start": "react-native start",
    "test": "echo 'See packages/refinement test' && node --test --import tsx test/*.test.ts",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:ios": "xcodebuild -workspace ios/WisperFlow.xcworkspace -scheme WisperFlow -configuration Release"
  },
  "dependencies": {
    "@wisper-flow/refinement": "file:../../packages/refinement",
    "react": "18.2.0",
    "react-native": "0.74.0",
    "@react-native-async-storage/async-storage": "^1.23.0",
    "react-native-keychain": "^8.2.0",
    "react-native-encrypted-storage": "^4.0.3"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "typescript": "^5.4.0",
    "tsx": "^4.7.0"
  }
}
